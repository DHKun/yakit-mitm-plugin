// panel.yak — Yakit GUI 面板输出
// 只有「结构化证据命中 + control 稳定」的结果进入表格与风险页；
// 普通 differential 作为 observation 写入日志。

PANEL_TABLE_TITLE = "AI 流量辅助检测"

panelInit = func() {
    yakit.AutoInitYakit()
    yakit.StatusCard("mitm-ai-sensor-status", "AI 流量辅助检测已启动：有界队列 → 候选重放 → 证据确认")
}

panelProgress = func(totalSeen, uniqueKept, candidatesGen, verified, observations, replaysUsed, jobsDropped) {
    yakit.StatusCard(
        "mitm-ai-sensor-status",
        sprintf("截获 %d | 去重保留 %d | 候选 %d | 已确认 %d | 观察 %d | 重放 %d | 丢弃 %d", totalSeen, uniqueKept, candidatesGen, verified, observations, replaysUsed, jobsDropped),
    )
}

panelReportVerified = func(traffic, candidate, diffResult, evidence) {
    table = yakit.NewTable("URL", "方法", "参数", "Payload", "漏洞类型", "证据", "diff_score", "来源")
    table.Append(
        string(traffic["url"]),
        string(traffic["method"]),
        string(candidate["param"]),
        string(candidate["payload"]),
        string(evidence["vuln_hint"]),
        string(evidence["kind"]),
        sprintf("%.3f", float(diffResult["diff_score"])),
        string(candidate["source"]),
    )
    yakit.Output(table)
    risk.NewRisk(
        string(traffic["url"]),
        risk.title(sprintf("[AI 辅助检测] %s 已确认: %s", evidence["vuln_hint"], candidate["param"])),
        risk.type(string(evidence["vuln_hint"])),
        risk.severity("low"),
        risk.description(sprintf(
            "payload: %s\n结构化证据: %s\n证据说明: %s\ncontrol 重放: stable\ndiff_score: %.3f\n变化段: %s",
            candidate["payload"], evidence["kind"], evidence["reason"],
            float(diffResult["diff_score"]), str.Join(diffResult["diff_regions"], " | "),
        )),
    )
}

panelReportObservation = func(traffic, candidate, diffResult, evidence) {
    kind = "none"
    reason = "dynamic response difference without type-matched evidence"
    if evidence != undefined && evidence != nil {
        if string(evidence["kind"]) != "" {
            kind = string(evidence["kind"])
        }
        if string(evidence["reason"]) != "" {
            reason = string(evidence["reason"])
        }
    }
    yakit.Info(
        "观察记录: %s %s param=%s hint=%s evidence=%s score=%.3f reason=%s",
        traffic["method"], traffic["url"], candidate["param"], candidate["vuln_hint"],
        kind, float(diffResult["diff_score"]), reason,
    )
}

panelReportVerdict = func(traffic, candidate, diffResult, evidence) {
    verdict = string(diffResult["verdict"])
    if verdict == "differential" {
        if evidence != undefined && evidence != nil && evidence["confirmed"] {
            panelReportVerified(traffic, candidate, diffResult, evidence)
        } else {
            panelReportObservation(traffic, candidate, diffResult, evidence)
        }
        return
    }
    if verdict == "replay_failed" {
        detail = ""
        if len(diffResult["diff_regions"]) > 0 {
            detail = diffResult["diff_regions"][0]
        }
        yakit.Warn("重放跳过: %s %s param=%s reason=%s", traffic["method"], traffic["url"], candidate["param"], detail)
        return
    }
    yakit.Info(
        "无差异(%s): %s %s param=%s payload=%s score=%.3f",
        verdict, traffic["method"], traffic["url"], candidate["param"], candidate["payload"], float(diffResult["diff_score"]),
    )
}
