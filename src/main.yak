// main.yak — 智能流量辅助检测插件 · 入口
// Yakit MITM 热加载插件（模块类型: mitm）
//
// 状态机: CAPTURED → DEDUP(同构丢弃) → PRUNE(剪枝) → PAYLOAD_GEN → DIFF(重放实证) → DISPLAY
// LLM 失败/超时 → fallback_dict 降级，主链路不中断。
//
// 参数机制：MITM 热加载插件使用 cli.* + cli.check()（在 Yakit 交互劫持界面以表单呈现）。
// 兼容 MITM_PARAMS（热加载/批量启用场景注入的全局 map，值全为 string）。
//
// 使用方式（二选一）：
// A. 插件仓库导入本插件 → MITM 交互劫持 → 插件页启用（参数以表单填写）
// B. MITM 交互劫持 → 热加载页粘贴全部代码（include 路径改为绝对路径或使用同目录相对路径）

// ---------- 模块加载 ----------
include "traffic/struct.yak"
include "traffic/dedup.yak"
include "traffic/prune.yak"
include "ai/schema.yak"
include "ai/payload_agent.yak"
include "diff/comparator.yak"
include "ui/panel.yak"

// ---------- 参数声明 ----------
llmBaseURL = cli.String("llm-base-url", cli.setDefault(""), cli.setVerboseName("LLM API 地址"), cli.setHelp("OpenAI 兼容 API 地址，如 https://api.openai.com/v1 或内网网关；留空则只走内置字典"))
llmAPIKey = cli.String("llm-api-key", cli.setVerboseName("LLM API Key"), cli.setHelp("API 密钥；留空表示无需鉴权的内网网关"))
llmModel = cli.String("llm-model", cli.setDefault("gpt-4o-mini"), cli.setVerboseName("模型名称"), cli.setHelp("OpenAI 兼容模型名"))
maxCandidatesPerParam = cli.Int("max-candidates", cli.setDefault(3), cli.setVerboseName("单参数候选上限"), cli.setHelp("每个参数最多生成的 payload 候选数（防死循环）"))
replayTimeout = cli.Float("replay-timeout", cli.setDefault(8.0), cli.setVerboseName("重放超时(秒)"), cli.setHelp("单次重放请求超时秒数"))
replayTotalLimit = cli.Int("replay-total-limit", cli.setDefault(60), cli.setVerboseName("会话重放总上限"), cli.setHelp("本次会话累计重放次数上限，防止对目标过度打点"))
maxBodyPreview = cli.Int("max-body-preview", cli.setDefault(512), cli.setVerboseName("body 预览长度"), cli.setHelp("记录进 TrafficRecord 的响应体预览长度"))
cli.check()

// ---------- 运行时状态 ----------
SENSOR_STATE = {
    "dedup": newDeduplicator(),
    "llm_client": nil,
    "llm_inited": false,
    "seen_total": 0,
    "kept_unique": 0,
    "candidates_gen": 0,
    "replayed": 0,
    "verified_diff": 0,
    "record_id": 0,
    "candidate_id": 0,
}

// initSensor 幂等初始化（参数优先级：cli > MITM_PARAMS）
initSensor = func() {
    if SENSOR_STATE["llm_inited"] {
        return
    }
    SENSOR_STATE["llm_inited"] = true
    baseURL = llmBaseURL
    apiKey = llmAPIKey
    model = llmModel
    // cli 参数为空时回落 MITM_PARAMS（热加载场景）
    if baseURL == "" {
        if MITM_PARAMS != undefined {
            v = MITM_PARAMS["llm-base-url"]
            if v != undefined && v != nil && string(v) != "" {
                baseURL = string(v)
            }
            v2 = MITM_PARAMS["llm-api-key"]
            if v2 != undefined && v2 != nil {
                apiKey = string(v2)
            }
            v3 = MITM_PARAMS["llm-model"]
            if v3 != undefined && v3 != nil && string(v3) != "" {
                model = string(v3)
            }
        }
    }
    SENSOR_STATE["llm_client"] = buildLlmClient({
        "base_url": baseURL,
        "api_key": apiKey,
        "model": model,
        "timeout": 30,
    })
    panelInit()
    if SENSOR_STATE["llm_client"] != nil {
        yakit.Info("LLM 客户端已配置 (model=%s)", model)
    } else {
        yakit.Info("LLM 未配置，将走内置字典降级路径")
    }
}

// extractParams 从请求报文提取参数 map（query + form post + json body 一层字段）
// 返回 [params, paramSource]，paramSource: "query" | "post" | "json"
extractParams = func(reqRaw) {
    packet = string(reqRaw)
    method = poc.GetHTTPRequestMethod(packet)
    contentType = poc.GetHTTPPacketHeader(packet, "Content-Type")
    if method == "GET" {
        return poc.GetAllHTTPPacketQueryParams(packet), "query"
    }
    if str.Contains(str.ToLower(contentType), "application/x-www-form-urlencoded") {
        return poc.GetAllHTTPPacketPostParams(packet), "post"
    }
    if str.Contains(str.ToLower(contentType), "application/json") {
        body = string(poc.GetHTTPPacketBody(packet))
        if !str.HasPrefix(str.TrimSpace(body), "{") {
            return {}, "json"
        }
        parsed = json.loads(body)
        if parsed == nil || parsed == undefined {
            return {}, "json"
        }
        params = {}
        for k, v in parsed {
            params[k] = string(v)
        }
        return params, "json"
    }
    // 其他类型（multipart/二进制）暂不处理
    return {}, "none"
}

// buildReplayPacket 构造重放报文：把 payload 写入指定参数
// 返回修改后的请求报文（string）
buildReplayPacket = func(reqRaw, param, payload, paramSource) {
    packet = string(reqRaw)
    if paramSource == "query" {
        return poc.ReplaceHTTPPacketQueryParam(packet, param, payload)
    }
    if paramSource == "post" {
        return poc.ReplaceHTTPPacketPostParam(packet, param, payload)
    }
    // json body：解析-改值-回写
    body = string(poc.GetHTTPPacketBody(packet))
    parsed = json.loads(body)
    if parsed == nil || parsed == undefined {
        return packet
    }
    parsed[param] = payload
    newBody = json.dumps(parsed)
    return string(poc.ReplaceHTTPPacketBody(packet, newBody))
}

// replayOnce 独立重放一次请求（不阻塞用户浏览的原始连接）
// 返回 [rspBytes, err]
replayOnce = func(isHttps, replayPacket) {
    opts = [poc.timeout(float(replayTimeout))]
    if isHttps {
        opts = append(opts, poc.https(true))
    }
    rsp, _, err = poc.HTTP(replayPacket, opts...)
    return rsp, err
}

// processFlow 处理一条被镜像的流量（状态机主体）
processFlow = func(isHttps, url, reqRaw, rspRaw) {
    defer func() {
        if err := recover(); err != nil {
            yakit.Error("处理流量异常: %v", err)
        }
    }()
    initSensor()

    packet = string(reqRaw)
    method = poc.GetHTTPRequestMethod(packet)

    // --- DEDUP ---
    params, paramSource = extractParams(packet)
    if len(params) == 0 {
        return
    }
    fingerprint = computeFingerprint(method, url, params)
    SENSOR_STATE["seen_total"] = SENSOR_STATE["seen_total"] + 1
    dup, seenCount = dedupSeen(SENSOR_STATE["dedup"], fingerprint)
    if dup {
        return // 同构请求保留首条
    }
    SENSOR_STATE["kept_unique"] = SENSOR_STATE["kept_unique"] + 1
    SENSOR_STATE["record_id"] = SENSOR_STATE["record_id"] + 1

    // --- PRUNE ---
    keptParams, pruned, total = pruneParams(params)
    if len(keptParams) == 0 {
        return
    }

    // --- 构造 TrafficRecord ---
    bodyPreview = string(poc.GetHTTPPacketBody(string(rspRaw)))
    if len(bodyPreview) > maxBodyPreview {
        bodyPreview = str.ShrinkString(bodyPreview, maxBodyPreview)
    }
    record = newTrafficRecord(
        SENSOR_STATE["record_id"], fingerprint, method, url,
        keysOf(keptParams), bodyPreview,
        poc.GetStatusCodeFromResponse(string(rspRaw)), len(bodyPreview),
        time.Now().Unix(),
    )

    // --- PAYLOAD_GEN + DIFF（逐参数逐候选）---
    path = normalizeUrlPath(url)
    for paramName, paramValue in keptParams {
        pType = paramTypeOf(paramValue)
        if pType == "bool" {
            continue // bool 参数无探测价值
        }
        cands, usedLlm = generateCandidates(SENSOR_STATE["llm_client"], paramName, paramValue, pType, method, path)
        if len(cands) == 0 {
            continue
        }
        if len(cands) > maxCandidatesPerParam {
            cands = cands[:maxCandidatesPerParam]
        }
        for c in cands {
            // 防死循环：会话总重放上限
            if SENSOR_STATE["replayed"] >= replayTotalLimit {
                yakit.Warn("已达会话重放上限 %d，停止后续重放", replayTotalLimit)
                return
            }
            SENSOR_STATE["candidate_id"] = SENSOR_STATE["candidate_id"] + 1
            candidate = newPayloadCandidate(
                SENSOR_STATE["candidate_id"], record["id"],
                c["param"], c["payload"], c["vuln_hint"], c["reason"],
                c["confidence"], c["expected_diff_signature"], c["source"],
            )
            SENSOR_STATE["candidates_gen"] = SENSOR_STATE["candidates_gen"] + 1

            // 重放：基线（原样重放）+ 变体（注入 payload）
            // 基线重放一次并缓存到 record（同 record 只打一次基线）
            if record["baseline_rsp"] == undefined {
                baseRsp, baseErr = replayOnce(isHttps, poc.FixHTTPRequest(packet))
                if baseErr != nil {
                    continue // 目标重放不可达，跳过该流量
                }
                record["baseline_rsp"] = baseRsp
            }
            replayPacket = buildReplayPacket(packet, candidate["param"], candidate["payload"], paramSource)
            varRsp, varErr = replayOnce(isHttps, replayPacket)
            SENSOR_STATE["replayed"] = SENSOR_STATE["replayed"] + 1
            if varErr != nil {
                dr = newDiffResult(candidate["id"], "", "", 0.0, "replay_failed", [string(varErr)])
                panelReportVerdict(record, candidate, dr)
                continue
            }
            // --- DIFF 判定 ---
            dr = compareResponses(candidate["id"], record["baseline_rsp"], varRsp)
            if dr["verdict"] == "differential" {
                SENSOR_STATE["verified_diff"] = SENSOR_STATE["verified_diff"] + 1
            }
            // --- DISPLAY ---
            panelReportVerdict(record, candidate, dr)
        }
    }
    panelProgress(SENSOR_STATE["seen_total"], SENSOR_STATE["kept_unique"], SENSOR_STATE["candidates_gen"], SENSOR_STATE["verified_diff"])
}

// keysOf 取 map 的键数组（保留原顺序）
keysOf = func(m) {
    out = []
    for k, _ in m {
        out = append(out, k)
    }
    return out
}

// ---------- MITM 镜像钩子注册 ----------
// mirrorFilteredHTTPFlow: 官方推荐的过滤镜像钩子（自动过滤 js/css/图片等静态资源）
mirrorFilteredHTTPFlow = func(isHttps, url, req, rsp, body) {
    go func() {
        defer func() {
            if err := recover(); err != nil {
                yakit.Error("镜像钩子异常: %v", err)
            }
        }()
        processFlow(isHttps, url, req, rsp)
    }()
}
