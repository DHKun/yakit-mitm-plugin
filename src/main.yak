// main.yak — 智能流量辅助检测插件 · 入口
// Yakit MITM 热加载插件（模块类型: mitm）
//
// 状态机: CAPTURED → DEDUP → PRUNE → PAYLOAD_GEN → REPLAY → EVIDENCE → DISPLAY
// Hook 只向有界队列提交任务；固定 worker 执行分析和重放。

// ---------- 模块加载 ----------
include "traffic/dedup.yak"
include "traffic/prune.yak"
include "ai/schema.yak"
include "ai/payload_agent.yak"
include "runtime/sensor_runtime.yak"
include "evidence/checker.yak"
include "ui/panel.yak"

// ---------- 参数声明 ----------
llmBaseURL = cli.String("llm-base-url", cli.setDefault(""), cli.setVerboseName("LLM API 地址"), cli.setHelp("OpenAI 兼容 API 地址；留空则只走内置字典"))
llmAPIKey = cli.String("llm-api-key", cli.setDefault(""), cli.setVerboseName("LLM API Key"), cli.setHelp("API 密钥；留空表示无需鉴权的内网网关"))
llmModel = cli.String("llm-model", cli.setDefault("gpt-4o-mini"), cli.setVerboseName("模型名称"), cli.setHelp("OpenAI 兼容模型名"))
maxCandidatesPerParam = cli.Int("max-candidates", cli.setDefault(3), cli.setVerboseName("单参数候选上限"), cli.setHelp("每个参数最多生成的 payload 候选数"))
replayTimeout = cli.Float("replay-timeout", cli.setDefault(8.0), cli.setVerboseName("重放超时(秒)"), cli.setHelp("单次重放请求超时秒数"))
replayTotalLimit = cli.Int("replay-total-limit", cli.setDefault(60), cli.setVerboseName("会话重放总上限"), cli.setHelp("baseline/variant/control 共用的一次性预算"))
runtimeWorkers = cli.Int("workers", cli.setDefault(2), cli.setVerboseName("分析 Worker 数"), cli.setHelp("固定并发 worker 数量"))
runtimeQueueSize = cli.Int("queue-size", cli.setDefault(256), cli.setVerboseName("任务队列容量"), cli.setHelp("队列满时新镜像任务会被丢弃"))
replayRPS = cli.Int("replay-rps", cli.setDefault(5), cli.setVerboseName("单站点每秒重放上限"), cli.setHelp("每个 origin 的令牌桶容量与每秒补充量"))
maxOrigins = cli.Int("max-origins", cli.setDefault(256), cli.setVerboseName("Origin 桶容量"), cli.setHelp("最多保留的 per-origin 限流状态数量"))
scopeHosts = cli.String("scope-hosts", cli.setDefault(""), cli.setVerboseName("目标 Host 白名单"), cli.setHelp("逗号分隔、精确匹配；空值仍拒绝保留/内网地址"))
maxPayloadLen = cli.Int("max-payload-len", cli.setDefault(256), cli.setVerboseName("Payload 最大长度"), cli.setHelp("AI 与内置字典 payload 的统一长度上限"))
timeDiffMs = cli.Int("time-diff-ms", cli.setDefault(2000), cli.setVerboseName("时延证据阈值(ms)"), cli.setHelp("variant 相对 baseline 的最小时延增量"))
maxBodyPreview = cli.Int("max-body-preview", cli.setDefault(512), cli.setVerboseName("Body 预览长度"), cli.setHelp("TrafficRecord 中保存的响应体预览长度"))
cli.check()

// MITM 热加载场景可注入全局 MITM_PARAMS（值为 string）。这里复制一次后只读，
// 避免 worker 并发读取一个可能被外部改写的普通 map。
MITM_PARAMS_CACHE = {}
if MITM_PARAMS != undefined && MITM_PARAMS != nil {
    for k, v in MITM_PARAMS {
        MITM_PARAMS_CACHE[k] = v
    }
}

cfgString = func(cliValue, name) {
    v = MITM_PARAMS_CACHE[name]
    if v != undefined && v != nil && str.TrimSpace(string(v)) != "" {
        return string(v)
    }
    return string(cliValue)
}

cfgInt = func(cliValue, name, minimum) {
    out = int(cliValue)
    v = MITM_PARAMS_CACHE[name]
    if v != undefined && v != nil && str.TrimSpace(string(v)) != "" {
        try {
            parsed = int(string(v))
            if parsed >= minimum {
                out = parsed
            }
        } catch e {
            yakit.Warn("参数 %s=%s 无法解析，使用默认值 %d", name, string(v), out)
        }
    }
    if out < minimum {
        out = minimum
    }
    return out
}

cfgFloat = func(cliValue, name, minimum) {
    out = float(cliValue)
    v = MITM_PARAMS_CACHE[name]
    if v != undefined && v != nil && str.TrimSpace(string(v)) != "" {
        try {
            parsed = float(string(v))
            if parsed >= minimum {
                out = parsed
            }
        } catch e {
            yakit.Warn("参数 %s=%s 无法解析，使用默认值 %.1f", name, string(v), out)
        }
    }
    if out < minimum {
        out = minimum
    }
    return out
}

resolvedWorkers = cfgInt(runtimeWorkers, "workers", 1)
resolvedQueueSize = cfgInt(runtimeQueueSize, "queue-size", 1)
resolvedReplayBudget = cfgInt(replayTotalLimit, "replay-total-limit", 1)
resolvedReplayRPS = cfgInt(replayRPS, "replay-rps", 1)
resolvedMaxOrigins = cfgInt(maxOrigins, "max-origins", 1)
resolvedScopeHosts = cfgString(scopeHosts, "scope-hosts")
resolvedReplayTimeout = cfgFloat(replayTimeout, "replay-timeout", 0.1)
resolvedMaxPayloadLen = cfgInt(maxPayloadLen, "max-payload-len", 8)
resolvedTimeDiffMs = cfgInt(timeDiffMs, "time-diff-ms", 1)
resolvedMaxBodyPreview = cfgInt(maxBodyPreview, "max-body-preview", 32)
resolvedMaxCandidates = cfgInt(maxCandidatesPerParam, "max-candidates", 1)

// include 中的函数在调用时读取这些全局阈值；探针与单测已验证重绑定生效。
MAX_PAYLOAD_LEN = resolvedMaxPayloadLen
EVIDENCE_DELAY_THRESHOLD_MS = resolvedTimeDiffMs

// ---------- 并发运行时与状态 ----------
SENSOR_RT = newSensorRuntime({
    "workers": resolvedWorkers,
    "queue_size": resolvedQueueSize,
    "replay_budget": resolvedReplayBudget,
    "rate_per_origin": resolvedReplayRPS,
    "rate_interval_ms": 1000,
    "max_origins": resolvedMaxOrigins,
    "scope_hosts": resolvedScopeHosts,
})

// 所有运行期可变状态均存入 sync.Map；复合读改写与去重器调用持 SENSOR_MU。
SENSOR_STATE = sync.NewMap()
SENSOR_STATE.Store("initialized", false)
SENSOR_STATE.Store("dedup", newDeduplicator())
SENSOR_STATE.Store("llm_client", undefined)
for k in ["seen_total", "kept_unique", "candidates_gen", "verified_diff", "observations", "skipped_scope", "skipped_method", "skipped_rate", "record_id", "candidate_id"] {
    SENSOR_STATE.Store(k, 0)
}
SENSOR_MU = sync.NewMutex()
SENSOR_INIT_MU = sync.NewMutex()

sensGet = func(key) {
    return SENSOR_STATE.Load(key)[0]
}

sensInc = func(key, n) {
    SENSOR_MU.Lock()
    value = int(SENSOR_STATE.Load(key)[0]) + n
    SENSOR_STATE.Store(key, value)
    SENSOR_MU.Unlock()
    return value
}

sensRegisterFlow = func(fingerprint) {
    SENSOR_MU.Lock()
    SENSOR_STATE.Store("seen_total", int(SENSOR_STATE.Load("seen_total")[0]) + 1)
    dedup = SENSOR_STATE.Load("dedup")[0]
    duplicate, seenCount = dedupSeen(dedup, fingerprint)
    recordId = 0
    if !duplicate {
        SENSOR_STATE.Store("kept_unique", int(SENSOR_STATE.Load("kept_unique")[0]) + 1)
        recordId = int(SENSOR_STATE.Load("record_id")[0]) + 1
        SENSOR_STATE.Store("record_id", recordId)
    }
    SENSOR_MU.Unlock()
    return duplicate, recordId
}

sensNextCandidate = func() {
    SENSOR_MU.Lock()
    candidateId = int(SENSOR_STATE.Load("candidate_id")[0]) + 1
    SENSOR_STATE.Store("candidate_id", candidateId)
    SENSOR_STATE.Store("candidates_gen", int(SENSOR_STATE.Load("candidates_gen")[0]) + 1)
    SENSOR_MU.Unlock()
    return candidateId
}

sensSnapshot = func() {
    SENSOR_MU.Lock()
    snap = {}
    for k in ["seen_total", "kept_unique", "candidates_gen", "verified_diff", "observations", "skipped_scope", "skipped_method", "skipped_rate"] {
        snap[k] = SENSOR_STATE.Load(k)[0]
    }
    SENSOR_MU.Unlock()
    return snap
}

// initSensor 初始化 LLM 与面板；并发 worker 只会执行一次。
initSensor = func() {
    if sensGet("initialized") {
        return
    }
    SENSOR_INIT_MU.Lock()
    if sensGet("initialized") {
        SENSOR_INIT_MU.Unlock()
        return
    }
    client = initLlm({
        "base_url": cfgString(llmBaseURL, "llm-base-url"),
        "api_key": cfgString(llmAPIKey, "llm-api-key"),
        "model": cfgString(llmModel, "llm-model"),
        "timeout": 30.0,
    })
    SENSOR_STATE.Store("llm_client", client)
    panelInit()
    SENSOR_STATE.Store("initialized", true)
    SENSOR_INIT_MU.Unlock()
    if client != nil && client != undefined {
        yakit.Info("LLM 客户端已配置")
    } else {
        yakit.Info("LLM 未配置，将走内置字典降级路径")
    }
}

// ---------- 请求解析与重放 ----------
extractParams = func(reqRaw) {
    packet = string(reqRaw)
    method = poc.GetHTTPRequestMethod(packet)
    contentType = poc.GetHTTPPacketHeader(packet, "Content-Type")
    if method == "GET" {
        return poc.GetAllHTTPPacketQueryParams(packet), "query"
    }
    if str.Contains(str.ToLower(contentType), "application/x-www-form-urlencoded") {
        return poc.GetAllHTTPPacketPostParams(packet), "post"
    }
    if str.Contains(str.ToLower(contentType), "application/json") {
        body = string(poc.GetHTTPPacketBody(packet))
        if !str.HasPrefix(str.TrimSpace(body), "{") {
            return {}, "json"
        }
        parsed = json.loads(body)
        if parsed == nil || parsed == undefined {
            return {}, "json"
        }
        params = {}
        for k, v in parsed {
            params[k] = string(v)
        }
        return params, "json"
    }
    return {}, "none"
}

buildReplayPacket = func(reqRaw, param, payload, paramSource) {
    packet = string(reqRaw)
    if paramSource == "query" {
        return poc.ReplaceHTTPPacketQueryParam(packet, param, payload)
    }
    if paramSource == "post" {
        return poc.ReplaceHTTPPacketPostParam(packet, param, payload)
    }
    body = string(poc.GetHTTPPacketBody(packet))
    parsed = json.loads(body)
    if parsed == nil || parsed == undefined {
        return packet
    }
    parsed[param] = payload
    return string(poc.ReplaceHTTPPacketBody(packet, json.dumps(parsed)))
}

replayOnce = func(isHttps, replayPacket) {
    opts = [poc.timeout(float(resolvedReplayTimeout))]
    if isHttps {
        opts = append(opts, poc.https(true))
    }
    rsp, _, err = poc.HTTP(replayPacket, opts...)
    return rsp, err
}

// guardedReplay 是所有主动网络请求的唯一出口。
// 每次请求依次通过 scope、method、per-origin 限流和统一预算。
guardedReplay = func(rt, purpose, isHttps, url, replayPacket) {
    method = poc.GetHTTPRequestMethod(string(replayPacket))
    if !rtInScope(rt, url) {
        sensInc("skipped_scope", 1)
        return nil, 0, "scope denied"
    }
    if !rtMethodAllowed(rt, method) {
        sensInc("skipped_method", 1)
        return nil, 0, "method denied"
    }
    if !rtAllowOrigin(rt, url) {
        sensInc("skipped_rate", 1)
        return nil, 0, "rate limited"
    }
    if !rtConsumeBudget(rt, purpose, 1) {
        return nil, 0, "replay budget exhausted"
    }
    startedAt = time.Now().UnixMilli()
    rsp, err = replayOnce(isHttps, replayPacket)
    elapsedMs = time.Now().UnixMilli() - startedAt
    return rsp, elapsedMs, err
}

keysOf = func(m) {
    out = []
    for k, _ in m {
        out = append(out, k)
    }
    return out
}

// ---------- 状态机 ----------
// processFlow 是同步处理接口；并发度由 SensorRuntime 的固定 worker 池控制。
processFlow = func(rt, isHttps, url, reqRaw, rspRaw) {
    initSensor()
    packet = string(reqRaw)
    method = poc.GetHTTPRequestMethod(packet)

    // 流量在进入去重与候选生成前先过静态门禁。
    if !rtMethodAllowed(rt, method) {
        sensInc("skipped_method", 1)
        return
    }
    if !rtInScope(rt, url) {
        sensInc("skipped_scope", 1)
        return
    }

    params, paramSource = extractParams(packet)
    if len(params) == 0 {
        return
    }
    fingerprint = computeFingerprint(method, url, params)
    duplicate, recordId = sensRegisterFlow(fingerprint)
    if duplicate {
        return
    }

    keptParams, pruned, total = pruneParams(params)
    if len(keptParams) == 0 {
        return
    }

    bodyPreview = string(poc.GetHTTPPacketBody(string(rspRaw)))
    if len(bodyPreview) > resolvedMaxBodyPreview {
        bodyPreview = str.ShrinkString(bodyPreview, resolvedMaxBodyPreview)
    }
    record = newTrafficRecord(
        recordId, fingerprint, method, url,
        keysOf(keptParams), bodyPreview,
        poc.GetStatusCodeFromResponse(string(rspRaw)), len(bodyPreview),
        time.Now().Unix(),
    )

    path = normalizeUrlPath(url)
    for paramName, paramValue in keptParams {
        pType = paramTypeOf(paramValue)
        if pType == "bool" {
            continue
        }
        cands, usedLlm = generateCandidates(sensGet("llm_client"), paramName, paramValue, pType, method, path)
        if len(cands) == 0 {
            continue
        }
        if len(cands) > resolvedMaxCandidates {
            cands = cands[:resolvedMaxCandidates]
        }
        for c in cands {
            candidate = newPayloadCandidate(
                sensNextCandidate(), record["id"],
                c["param"], c["payload"], c["vuln_hint"], c["reason"],
                c["confidence"], c["expected_diff_signature"], c["source"],
            )

            // 同一 record 只重放一次 baseline，后续候选复用响应与耗时。
            if record["baseline_rsp"] == undefined {
                baseRsp, baseMs, baseErr = guardedReplay(rt, "baseline", isHttps, url, poc.FixHTTPRequest(packet))
                if baseErr != nil {
                    yakit.Warn("基线重放跳过: %s %s (%s)", method, url, string(baseErr))
                    return
                }
                record["baseline_rsp"] = baseRsp
                record["baseline_ms"] = baseMs
            }

            replayPacket = buildReplayPacket(packet, candidate["param"], candidate["payload"], paramSource)
            varRsp, varMs, varErr = guardedReplay(rt, "variant", isHttps, url, replayPacket)
            if varErr != nil {
                dr = newDiffResult(candidate["id"], "", "", 0.0, "replay_failed", [string(varErr)])
                panelReportVerdict(record, candidate, dr, undefined)
                continue
            }

            dr = compareResponses(candidate["id"], record["baseline_rsp"], varRsp)
            evidence = undefined
            if dr["verdict"] == "differential" {
                evidence = matchEvidence(
                    candidate["vuln_hint"], candidate["expected_diff_signature"], candidate["payload"],
                    record["baseline_rsp"], varRsp, record["baseline_ms"], varMs,
                )
                evidence["control_confirmed"] = false
                evidence["confirmed"] = false

                // 结构化证据命中后再做 control 重放，确认差异可归因于 payload。
                if evidence["matched"] {
                    ctrlRsp, ctrlMs, ctrlErr = guardedReplay(rt, "control", isHttps, url, poc.FixHTTPRequest(packet))
                    if ctrlErr == nil && controlStable(record["baseline_rsp"], ctrlRsp) {
                        evidence["control_confirmed"] = true
                        evidence["confirmed"] = true
                    } else if ctrlErr != nil {
                        evidence["reason"] = string(evidence["reason"]) + "; control replay failed: " + string(ctrlErr)
                    } else {
                        evidence["reason"] = string(evidence["reason"]) + "; control response is unstable"
                    }
                }

                if evidence["confirmed"] {
                    sensInc("verified_diff", 1)
                } else {
                    sensInc("observations", 1)
                }
            }
            panelReportVerdict(record, candidate, dr, evidence)
        }
    }

    snap = sensSnapshot()
    metrics = rtMetrics(rt)
    panelProgress(
        snap["seen_total"], snap["kept_unique"], snap["candidates_gen"],
        snap["verified_diff"], snap["observations"], metrics["replays_used"], metrics["jobs_dropped"],
    )
}

// ---------- MITM Hook 与 worker 启动 ----------
// Hook 无网络、无 LLM、无派生 goroutine；队列满时快速丢弃并记 metrics。
mirrorFilteredHTTPFlow = func(isHttps, url, req, rsp, body) {
    rtSubmit(SENSOR_RT, {
        "is_https": isHttps,
        "url": string(url),
        "req": string(req),
        "rsp": string(rsp),
    })
}

rtSetHandler(SENSOR_RT, func(job) {
    processFlow(SENSOR_RT, job["is_https"], job["url"], job["req"], job["rsp"])
})
rtStart(SENSOR_RT)
